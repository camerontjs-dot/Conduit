  "metrics": [
    {
      "name": "mandatory_coverage",
      "formula": "selected exact mandatory identities / declared mandatory identities; undefined when denominator0",
      "interpretation": "Refusal is reported separately; incomplete source cannot count as covered"
    },
    {
      "name": "authority_confusion_count",
      "formula": "count of items whose delivered authority exceeds declared source class",
      "interpretation": "No PASS/current/verified word inference"
    },
    {
      "name": "stale_admitted_count",
      "formula": "count of admitted items with declared stale freshness",
      "interpretation": "Also report whether stale status was visible"
    },
    {
      "name": "irrelevant_selected_bytes",
      "formula": "sum exact selected bytes for prelabelled irrelevant sources",
      "interpretation": "Labels frozen before retrieval measurements"
    },
    {
      "name": "duplicate_retained_bytes",
      "formula": "sum selected bytes minus bytes in exact deduplicated source identities, stratified by authority/representation",
      "interpretation": "Different authority/representation is not automatically redundant"
    },
    {
      "name": "latency",
      "formula": "wall elapsed time from declared request to complete receipt; report cold/warm sample counts, median,p95,max",
      "interpretation": "No performance PASS without a frozen objective target"
    }
  ],
